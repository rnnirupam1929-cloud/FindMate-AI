# Leave both empty for local development (uses the backend's built-in dev auth).
# Set both to use Supabase Auth (the anon key is public by design; never put the service-role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave empty for same-origin /api (including the single Vercel project); Vite proxies locally.
VITE_API_BASE_URL=
