# ---------- Backend (backend/.env) ----------
APP_ENV=local                       # local | test | production
AUTH_MODE=local                     # local = dev auth (never in production) | supabase
DATABASE_URL=sqlite:///./findmate.db   # production: postgresql+psycopg2://USER:PASS@HOST:5432/postgres
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=                       # comma separated; get the admin role on first sign-in

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in the frontend
SUPABASE_JWT_SECRET=                # Supabase > Project Settings > API > JWT secret
SUPABASE_STORAGE_BUCKET=report-images
STORAGE_BACKEND=local               # local | supabase

# ---------- Frontend (frontend/.env) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=             # public anon key only
VITE_API_BASE_URL=                  # empty in dev (Vite proxies /api)
