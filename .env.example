# ---------- Backend (backend/.env) ----------
APP_ENV=local                       # local | test | production
AUTH_MODE=local                     # local = dev auth (never in production) | supabase
DATABASE_URL=sqlite:///./findmate.db   # production: postgresql+psycopg2://USER:PASS@HOST:5432/postgres
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=                       # comma separated; get the admin role on first sign-in

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never in the frontend
SUPABASE_JWT_SECRET=local-dev-secret-change-me-32-bytes-min!! # local only; production needs this only for legacy HS256 JWTs
SUPABASE_STORAGE_BUCKET=report-images
STORAGE_BACKEND=local               # local | supabase
LOCAL_STORAGE_DIR=./storage         # local mode only
SIGNED_URL_TTL_SECONDS=600
MAX_UPLOAD_BYTES=5242880

# Matching and agent tuning (defaults shown).
EMBEDDING_BACKEND=none               # none | openclip; OpenCLIP weights are not suitable for Vercel Functions by default
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
MATCH_THRESHOLD=35
AGENT_TIMEOUT_SECONDS=10
AGENT_MAX_RETRIES=1
RATE_LIMIT_ENABLED=true              # in-memory/per-instance on Vercel; not a global rate limiter

# ---------- Frontend (frontend/.env) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=             # public anon key only
VITE_API_BASE_URL=                  # leave empty for one-project same-origin /api; Vite proxies locally
